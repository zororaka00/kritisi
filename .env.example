# Kritisi Environment Configuration
# Do not commit real credentials to the repository.

# Optional path to a user-local configuration file
# KRITISI_CONFIG_PATH=/absolute/path/to/kritisi-config.json


# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions


# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions


# Claude / Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Alternative Claude variable names
# CLAUDE_API_KEY=
# CLAUDE_MODEL=
# CLAUDE_BASE_URL=


# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions