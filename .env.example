# Kritisi Environment Configuration
# Do not commit real credentials to the repository.

# Optional path to a user-local configuration file
# KRITISI_CONFIG_PATH=/absolute/path/to/kritisi-config.json


# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions


# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions


# Claude / Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
# ANTHROPIC_MAX_TOKENS=8192

# Alternative Claude variable names
# CLAUDE_API_KEY=
# CLAUDE_MODEL=
# CLAUDE_BASE_URL=
# CLAUDE_MAX_TOKENS=8192


# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions


# Runtime tuning
# KRITISI_TIMEOUT_MS=120000
# KRITISI_RETRIES=2
# KRITISI_RETRY_DELAY_MS=500
