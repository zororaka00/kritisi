{
  "name": "kritisi",
  "version": "2.2.0",
  "description": "AI-powered Solidity security auditing and NatSpec documentation CLI with multiple providers.",
  "main": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "require": "./dist/library.js",
      "default": "./dist/library.js"
    },
    "./cli": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "kritisi": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:help": "node ./dist/index.js help",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zororaka00/kritisi.git"
  },
  "homepage": "https://github.com/zororaka00/kritisi/blob/main/README.md",
  "keywords": [
    "ethereum",
    "smart-contract",
    "solidity",
    "tooling",
    "ai",
    "openrouter",
    "security",
    "audit",
    "blockchain",
    "vulnerability"
  ],
  "author": "Raka Widhi Antoro",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "node-fetch": "^2.7.0",
    "ora": "^5.4.1",
    "pdfkit": "^0.17.2",
    "sol-merger": "^4.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/node-fetch": "^2.6.12",
    "@types/pdfkit": "^0.17.6",
    "jest": "^29.7.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/?(*.)+(spec|test).js"
    ],
    "clearMocks": true
  }
}
